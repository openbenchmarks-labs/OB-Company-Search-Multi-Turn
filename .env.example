CONTEXT_API_KEY=
# Model for the fixed research agent: Azure OpenAI by default. AZURE_OPENAI_BASE_URL is the deployment's
# OpenAI v1 URL (ending in /openai/v1), and --model is the deployment name.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
# OpenAI instead: leave both Azure variables empty and set this.
OPENAI_API_KEY=

# Configure only the search providers selected with --vendors.
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
LINKUP_API_KEY=
PARALLEL_API_KEY=
SELTZ_API_KEY=
RAPIDAPI_KEY=
TAVILY_API_KEY=
YOU_API_KEY=
TINYFISH_API_KEY=
PERPLEXITY_API_KEY=
KEENABLE_API_KEY=
SPECSTREAM_API_KEY=

# Optional limits for the bounded HTTP/Playwright fallback.
COMPANY_RESEARCH_FETCH_MAX_BROWSERS=4
COMPANY_RESEARCH_FETCH_NAV_TIMEOUT_MS=12000
COMPANY_RESEARCH_FETCH_SETTLE_MS=2000

# Nimble Search / Agents
NIMBLE_API_KEY=
